  "cards": [
    {
      "dot": "cyan",
      "title": "When it checks",
      "items": [
        "Your first real prompt in a session",
        "A new scope word such as architecture, migration or security",
        "Every fourth prompt, or when you send model advisor recheck"
      ]
    },
    {
      "dot": "slate",
      "title": "When it stays quiet",
      "items": [
        "Short replies such as ok or thanks, and repeated prompts",
        "Less than 30 seconds after the last check",
        "No upgrade, or the same suggestion inside the 15-minute cooldown"
      ]
    },
    {
      "dot": "rose",
      "title": "What it never does",
      "items": [
        "Switch your model or effort",
        "Hold your prompt past the 10-second hook timeout",
        "Read your files or the full transcript"
      ]
    }
